text = "LUNAR COLONY — DEBUG"
theme_override_colors/font_color = Color(0.36, 0.71, 0.84, 1)
theme_override_font_sizes/font_size = 14

[node name="TimeLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Day 0  06:00"
theme_override_colors/font_color = Color(0.91, 0.93, 0.95, 1)

[node name="PhaseLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Phase: DAY"
theme_override_colors/font_color = Color(0.91, 0.93, 0.95, 1)

[node name="Sep" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="Resources" type="VBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 2
